{
  "expo": {
    "name": "Andpatelec",
    "slug": "andpatelec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "andpatelec",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andpatelec.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFC800",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.andpatelec.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14181F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Andpatelec necesita acceso a tus fotos para agregar imágenes a los materiales.",
          "cameraPermission": "Andpatelec necesita acceso a la cámara para tomar fotos de los materiales."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "name": "Andpatelec",
      "shortName": "Andpatelec",
      "backgroundColor": "#F3F4F6",
      "themeColor": "#14181F",
      "favicon": "./assets/images/favicon.png"
    }
  }
}
